# Secrets and local configuration - never commit
application-local.yml
application-local.properties
*.env
.env*
*.pem
*.key

# Backend build output
backend/target/
# JDK and jar produced by the Render build script
backend/.jdk/
backend/app.jar
backend/.mvn/wrapper/maven-wrapper.jar

# Frontend (see also frontend/.gitignore)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
*.tsbuildinfo

# Logs
*.log
logs/

# IDE / OS
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.DS_Store
Thumbs.db

# Office lock files
~$*

# Docker deployment: real settings, local backups and built releases never go to git.
deploy/.env
deploy/backups/
release/
!deploy/.env.example
