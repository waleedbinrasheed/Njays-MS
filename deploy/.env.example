# Leading Publishers Inventory - settings for this PC.
# Copy this file to ".env" (install.bat does that for you), fill in the values, and keep it private:
# it contains the database password. Never share or e-mail the .env file.

# --- Required -------------------------------------------------------------
# Database password: long and random, e.g. 20+ letters and digits. Do not change it after the
# first start (the database keeps the password it was created with).
DB_PASSWORD=CHANGE_ME

# Temporary password for the first administrator ("admin"), used only on the very first start.
# At least 8 characters; you must choose a new one at first sign-in.
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# --- Invoice header -------------------------------------------------------
BUSINESS_NAME=Leading Publishers
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# --- Optional -------------------------------------------------------------
# Port other PCs use: http://<this-pc-ip> for 80, or http://<this-pc-ip>:8080 if you set 8080.
HTTP_PORT=80
APP_TIMEZONE=Asia/Karachi
# Sign out after this much inactivity, e.g. 15m, 30m, 1h.
SESSION_TIMEOUT=30m
# Daily database backup: first check after this hour (24h clock), kept this many days.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
